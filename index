<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Combining Data in Tableau</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;800&family=Figtree:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f5f8fc;--card:#fff;--ink:#14203a;--mut:#58647c;--line:#d9e1ec;--teal:#0a8a7a;--tb:#def4f0;--amb:#a85f00;--ab:#ffefcf;--blue:#2457d6;--bb:#e4ecfd;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*:before,*:after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.6 Figtree,system-ui,sans-serif}
h1,h2{font-family:'Bricolage Grotesque',Figtree,system-ui,sans-serif;line-height:1.15;margin:0 0 .5rem}
h1{font-size:clamp(2.2rem,7vw,3.6rem);font-weight:800;letter-spacing:-.02em}
h2{font-size:1.7rem;font-weight:800}
h3{font-size:1rem;margin:.9rem 0 .3rem}
main,header{max-width:900px;margin:0 auto;padding:0 20px}
header{padding-top:44px}
section{padding:36px 0 8px;border-top:1px solid var(--line);margin-top:36px}
p{margin:.4rem 0}.m{color:var(--mut)}.big{font-size:1.4rem;font-weight:600}
nav{display:flex;flex-wrap:wrap;gap:8px;margin:18px 0}
nav a{padding:6px 14px;border:1px solid var(--line);border-radius:99px;background:var(--card);color:var(--ink);text-decoration:none;font-size:.9rem}
nav a:hover{border-color:var(--blue);color:var(--blue)}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:18px}
.bs{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0}
.b{font:600 .95rem Figtree,sans-serif;padding:9px 16px;border:1.5px solid var(--line);border-radius:10px;background:var(--card);color:var(--ink);cursor:pointer;transition:background .2s,color .2s,border-color .2s}
.b:hover:not(:disabled){border-color:var(--blue)}
.b.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.b.good{background:var(--tb);border-color:var(--teal)}.b.bad{background:var(--ab);border-color:var(--amb)}
.b:disabled{cursor:default}
a:focus-visible,.b:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
.g{display:grid;grid-template-columns:1fr 1fr;gap:14px}
@media(max-width:640px){.g{grid-template-columns:1fr}}
.w{overflow-x:auto}
.t{border-collapse:collapse;width:100%;font-size:.86rem}
.t th{text-align:left;background:var(--bb);padding:6px 10px;white-space:nowrap}
.t td{padding:6px 10px;border-top:1px solid var(--line);white-space:nowrap}
.t i{color:var(--amb);font-style:normal;font-weight:600}
.t tr.ok td{background:var(--tb)}.t tr.miss td{background:var(--ab)}.t tr.drop td{opacity:.4}
.a tr{animation:pop .45s both}.a tr.u2{animation-name:slide}
@keyframes pop{from{opacity:0;transform:translateY(10px)}}
@keyframes slide{from{opacity:0;transform:translateX(40px)}}
.note{background:var(--bb);border-radius:10px;padding:10px 14px;margin:12px 0}
dl{display:grid;grid-template-columns:200px 1fr;gap:0 18px;margin:0}
dt{font-weight:600;padding:10px 0;border-top:1px solid var(--line)}dd{margin:0;padding:10px 0;border-top:1px solid var(--line);color:var(--mut)}
@media(max-width:640px){dl{grid-template-columns:1fr}dt{padding-bottom:0}dd{border-top:0;padding-top:2px}}
footer{max-width:900px;margin:40px auto;padding:0 20px;color:var(--mut);font-size:.9rem}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important;scroll-behavior:auto!important}}
</style></head><body>
<header>
<h1>Combining Data in Tableau</h1>
<p class="m">Four ways to bring tables together, with live demos built on a small student, department and marks dataset.</p>
<nav><a href="#defs">Definitions</a><a href="#joins">Joins</a><a href="#unions">Unions</a><a href="#blend">Blending</a><a href="#quiz">Quiz</a><a href="#ref">Cheat sheet</a></nav>
<div class="card"><h3 style="margin-top:0">Pick a method</h3><div class="bs" id="pk"></div><div id="pp"></div></div>
</header>
<main>
<section id="defs"><h2>Definitions</h2><dl id="dl"></dl></section>

<section id="joins"><h2>Join explorer</h2>
<p class="m">A join matches rows from two tables on a key. Choose a type and watch which rows survive. Green rows match, amber rows have no partner, faded rows are dropped.</p>
<div class="bs" id="jb"></div>
<div class="g"><div><h3>Students</h3><div id="js"></div></div><div><h3>Departments</h3><div id="jd"></div></div></div>
<h3>Result</h3><div id="jr"></div><div class="note" id="jn"></div></section>

<section id="unions"><h2>Union stacking</h2>
<p class="m">A union stacks rows from tables that share the same columns. Tableau adds a field telling you where each row came from.</p>
<div class="bs"><button class="b on" data-m="Sheet">Manual union (sheets)</button><button class="b" data-m="Path">Wildcard union (files)</button></div>
<div class="g"><div><h3>Students_2024</h3><div id="ua"></div></div><div><h3>Students_2025</h3><div id="ub"></div></div></div>
<div class="bs"><button class="b" id="ug">Stack the tables</button></div>
<div id="ur"></div></section>

<section id="blend"><h2>Data blending</h2>
<p class="m">Blending joins two separate data sources after each is aggregated. Step through it.</p>
<div class="g"><div><h3>Primary: marks workbook (average by department)</h3><div id="bp"></div></div><div><h3>Secondary: Department_Targets.csv</h3><div id="bs"></div></div></div>
<div class="bs"><button class="b on" id="bb"></button></div>
<div class="note" id="bn"></div><div id="br"></div></section>

<section id="quiz"><h2>Which method would you use?</h2><div class="card" id="qz"></div></section>

<section id="ref"><h2>Cheat sheet</h2><div class="w card"><table class="t">
<tr><th>Method</th><th>Combines</th><th>Use when</th><th>Watch out</th></tr>
<tr><td>Relationships</td><td>Columns, per view</td><td>Tables at different levels of detail</td><td>Unused tables are not queried</td></tr>
<tr><td>Join</td><td>Columns, fixed</td><td>Same level of detail, a specific join type needed</td><td>Duplicates when one key matches many rows</td></tr>
<tr><td>Union</td><td>Rows</td><td>Same structure split across sheets or files</td><td>Column names must match</td></tr>
<tr><td>Blending</td><td>Columns, after aggregation</td><td>Separate sources that cannot be joined</td><td>Only primary source rows appear</td></tr></table></div></section>
</main>
<footer>Tableau also offers Custom SQL and Tableau Prep for joins and unions before analysis. There is no separate feature called merge.</footer>
<script>
const $=s=>document.querySelector(s),H=(e,h)=>e.innerHTML=h,$$=s=>document.querySelectorAll(s);
const T=(c,r,cl=[],a='')=>`<div class=w><table class="t ${a}"><tr>${c.map(x=>`<th>${x}</th>`).join('')}</tr>${r.map((x,i)=>`<tr class="${cl[i]||''}" style="animation-delay:${i*90}ms">${x.map(v=>`<td>${v==null?'<i>null</i>':v}</td>`).join('')}</tr>`).join('')}</table></div>`;
const P={Relationships:["Columns, decided per view","Your tables sit at different levels of detail and you want Tableau to pick the join for each view.","Students and Enrollments linked on student_id. Counts stay correct with no duplicated rows."],Joins:["Columns, fixed when you connect","Tables share a level of detail and you need a specific join type.","Students joined to Departments with a left join so no student disappears."],Unions:["Rows","The same columns are split across sheets or files.","Students_2024 and Students_2025 stacked into one table."],Blending:["Columns, after aggregation","Data lives in separate sources that cannot be joined.","Marks in Excel blended with department targets in a CSV."]};
function pick(k){$$('#pk .b').forEach(b=>b.classList.toggle('on',b.textContent==k));H($('#pp'),`<p><b>Combines:</b> ${P[k][0]}</p><p><b>Use it when:</b> ${P[k][1]}</p><p><b>Example:</b> ${P[k][2]}</p>`)}
H($('#pk'),Object.keys(P).map(k=>`<button class=b>${k}</button>`).join(''));$$('#pk .b').forEach(b=>b.onclick=()=>pick(b.textContent));pick('Relationships');
const DF=[["Relationship","A link between two tables on a shared field. The tables stay separate and Tableau decides how to join them for each view. Example: Students and Enrollments linked on student_id."],["Join","Combines two tables side by side by matching rows on a key field. The join type is fixed when you connect. Example: Students joined to Departments on dept_id."],["Inner join","Keeps only rows that match in both tables."],["Left join","Keeps every row from the left table and adds matches from the right. Unmatched rows get nulls."],["Right join","Keeps every row from the right table and adds matches from the left."],["Full outer join","Keeps every row from both tables, matched or not."],["Union","Stacks the rows of tables that have the same columns. Example: Students_2024 on top of Students_2025."],["Manual union","You pick the sheets or tables to stack yourself."],["Wildcard union","Tableau stacks every file or sheet whose name fits a pattern, such as Marks_Sem*."],["Data blending","Combines two separate data sources after each is aggregated, using a linking field. The primary source decides which rows appear."],["Primary and secondary source","The primary source is the one you build the view with. The secondary source adds fields through the link."],["Linking field","A field both sources share, such as dept_id. Matching names link automatically."],["Logical layer","The top canvas where relationships are drawn between logical tables."],["Physical layer","The canvas inside a logical table where joins and unions are built."],["Level of detail","What one row stands for. Marks has one row per enrollment, Department_Targets has one per department."],["Null (unmatched row)","The blank value shown when a row has no partner on the other side."]];
H($('#dl'),DF.map(d=>`<dt>${d[0]}</dt><dd>${d[1]}</dd>`).join(''));
const S=[["S001","Aarav Sharma","D01"],["S002","Priya Nair","D02"],["S003","Ananya Iyer","D03"],["S004","Vikram Singh","D09"]],D=[["D01","Computer Science"],["D02","Mechanical Eng."],["D03","Commerce"],["D05","Fine Arts"]];
const JT={inner:["Inner","Only matching rows. S004 (D09) and D05 are dropped."],left:["Left","Every student. S004 stays with a null department."],right:["Right","Every department. D05 stays with no student."],outer:["Full outer","Everything from both sides. Both unmatched rows stay."]};
function showJ(t){const ds=D.map(d=>d[0]),ss=S.map(s=>s[2]),r=[],c=[],L=t=='left'||t=='outer',R=t=='right'||t=='outer';
S.forEach(s=>{const d=D.find(d=>d[0]==s[2]);if(d){r.push([...s,d[1]]);c.push('ok')}else if(L){r.push([...s,null]);c.push('miss')}});
if(R)D.forEach(d=>{if(!ss.includes(d[0])){r.push([null,null,d[0],d[1]]);c.push('miss')}});
H($('#js'),T(["student_id","name","dept_id"],S,S.map(s=>ds.includes(s[2])?'ok':L?'miss':'drop')));
H($('#jd'),T(["dept_id","dept_name"],D,D.map(d=>ss.includes(d[0])?'ok':R?'miss':'drop')));
H($('#jr'),T(["student_id","name","dept_id","dept_name"],r,c,'a'));
$('#jn').textContent=`${JT[t][0]} join gives ${r.length} rows. ${JT[t][1]}`;
$$('#jb .b').forEach(b=>b.classList.toggle('on',b.dataset.t==t))}
H($('#jb'),Object.keys(JT).map(k=>`<button class=b data-t=${k}>${JT[k][0]} join</button>`).join(''));$$('#jb .b').forEach(b=>b.onclick=()=>showJ(b.dataset.t));showJ('inner');
const A=[["S001","Aarav Sharma","D01"],["S002","Priya Nair","D01"],["S003","Ananya Iyer","D01"]],B=[["S011","Pooja Desai","D03"],["S012","Karthik Subramanian","D03"],["S013","Divya Joshi","D04"]],C3=["student_id","name","dept_id"];let um='Sheet';
function stack(go){H($('#ua'),T(C3,A));H($('#ub'),T(C3,B));const m=um=='Sheet',x=y=>m?'Students_'+y:'Students_'+y+'.csv';
H($('#ur'),go?T([...C3,m?'Table Name':'Path'],[...A.map(r=>[...r,x(2024)]),...B.map(r=>[...r,x(2025)])],[...A.map(_=>'u1'),...B.map(_=>'u2')],'a'):'<p class=m>Press the button to see the stacked result.</p>')}
$$('#unions [data-m]').forEach(b=>b.onclick=()=>{um=b.dataset.m;$$('#unions [data-m]').forEach(x=>x.classList.toggle('on',x==b));stack(false)});$('#ug').onclick=()=>stack(true);stack(false);
const PR=[["D01",72.4],["D02",66.1],["D03",69.8],["D04",74.2]],TG=[["D01",75],["D02",72],["D03",70],["D04",74],["D05",68]];let bs=0;
function showB(){const l=bs>0,k=l?" (linked)":"";
H($('#bp'),T(["dept_id"+k,"avg_marks"],PR,PR.map(_=>l?'ok':'')));
H($('#bs'),T(["dept_id"+k,"target_avg_marks"],TG,TG.map(t=>l?(PR.some(p=>p[0]==t[0])?'ok':'drop'):'')));
H($('#br'),bs>1?T(["dept_id","avg_marks","target","gap"],PR.map(p=>{const t=TG.find(t=>t[0]==p[0])[1],g=p[1]-t;return[p[0],p[1],t,(g>0?'+':'')+g.toFixed(1)]}),[],'a'):'');
$('#bn').textContent=['Two separate sources: a workbook (primary) and a CSV (secondary). Nothing is linked yet.','Linked on dept_id. D05 has a target but no match in the primary source.','Blended. Rows come only from the primary source, so D05 is left out.'][bs];
$('#bb').textContent=['Link on dept_id','Blend the data','Start over'][bs]}
$('#bb').onclick=()=>{bs=(bs+1)%3;showB()};showB();
const Q=[["Marks_Sem1, Marks_Sem2 and Marks_Sem3 are CSV files with identical columns. You want one table.","Union","Same columns split across files: stack them with a wildcard union (Marks_Sem*)."],["Students and Departments are in one workbook. You need every student, even those with no department.","Join","A left join keeps every row from Students and fills nulls where no department matches."],["Marks sit in an Excel file. Department targets sit in a separate CSV at department level.","Data blending","Different sources at different levels of detail: link on dept_id and blend."],["Students and Enrollments are in one database. Student counts must stay correct when a student has many enrollments.","Relationships","Relationships aggregate before combining, so counts do not get duplicated."],["Students_2024 and Students_2025 are two sheets with the same columns.","Union","Stack the sheets with a manual union."]],OP=["Relationships","Join","Union","Data blending"];let qi=0,sc=0;
function showQ(){const e=$('#qz');if(qi>=Q.length){H(e,`<p class=big>You scored ${sc} of ${Q.length}.</p><button class=b id=rq>Try again</button>`);$('#rq').onclick=()=>{qi=sc=0;showQ()};return}
const q=Q[qi];H(e,`<p class=m>Question ${qi+1} of ${Q.length}</p><p><b>${q[0]}</b></p><div class=bs>${OP.map(o=>`<button class=b>${o}</button>`).join('')}</div><div id=qf></div>`);
e.querySelectorAll('.bs .b').forEach(b=>b.onclick=()=>{const ok=b.textContent==q[1];if(ok)sc++;e.querySelectorAll('.bs .b').forEach(x=>{x.disabled=true;if(x.textContent==q[1])x.classList.add('good')});if(!ok)b.classList.add('bad');
H($('#qf'),`<p>${ok?'Correct. ':'Not quite. '}${q[2]}</p><button class=b id=nx>${qi==Q.length-1?'See score':'Next question'}</button>`);$('#nx').onclick=()=>{qi++;showQ()}})}
showQ();
</script></body></html>
